# Keys live outside the repo, in
#   C:\Users\patri\Desktop\envmachine\accelerator-platform\development\.env.development.local
# and are injected by C:\Users\patri\Desktop\startup-accelerate.bat (dotenv-cli).
# Plain `pnpm dev` runs without keys: the demo tenant works; Run Lighthouse needs PAGESPEED_API_KEY.

# ── apps/console ─────────────────────────────────────────────
# Where the console's server components reach the API server.
API_URL=http://localhost:4001

# ── apps/api ─────────────────────────────────────────────────
# Supabase (control-plane database). Unset = the seeded in-memory demo tenant.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Real Lighthouse runs from the Health page (Google PageSpeed Insights API).
PAGESPEED_API_KEY=
